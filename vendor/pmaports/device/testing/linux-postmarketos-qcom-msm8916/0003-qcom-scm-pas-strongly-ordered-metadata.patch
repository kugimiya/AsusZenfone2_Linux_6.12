+#ifdef CONFIG_ARM64
+struct qcom_scm_pas_mt_data {
+	u64 mt;
+	bool to_device;
+};
+
+static int qcom_scm_pas_set_mt_pte(pte_t *ptep, unsigned long addr, void *data)
+{
+	struct qcom_scm_pas_mt_data *chg = data;
+	pte_t pte = __ptep_get(ptep);
+
+	(void)addr;
+	pte = clear_pte_bit(pte, __pgprot(PTE_ATTRINDX_MASK));
+	pte = set_pte_bit(pte, __pgprot(PTE_ATTRINDX(chg->mt)));
+	/*
+	 * A clean linear-map page has PTE_RDONLY set. A store would fault
+	 * and dirty it. Device-nGnRnE must be written without that fault.
+	 */
+	if (chg->to_device) {
+		pte = clear_pte_bit(pte, __pgprot(PTE_RDONLY));
+		pte = set_pte_bit(pte, __pgprot(PTE_WRITE | PTE_DIRTY | PTE_AF));
+	}
+	__set_pte(ptep, pte);
+	return 0;
+}
+
+/*
+ * arm64 set_memory_* / set_direct_map_* cannot retarget a page to
+ * MT_DEVICE_nGnRnE (pgprot_noncached()). ioremap_prot() refuses system
+ * RAM, and vmap/ioremap would add a second alias over the cacheable
+ * linear map. That alias is architecturally mismatched and hangs TZ.
+ *
+ * When can_set_direct_map() is true the linear map is already
+ * page-granular, so no live block mapping is split. Break-before-make
+ * is required: pgattr_change_is_safe() rejects a live Normal -> Device
+ * attribute change. One mapping remains: the linear map itself.
+ *
+ * Returns 0 when the requested type is installed and valid. On failure
+ * the PTEs may be invalid; the caller must not free the pages unless a
+ * later call with to_device=false returns 0.
+ */
+static int qcom_scm_pas_set_linear_mt(void *ptr, size_t len, bool to_device)
+{
+	unsigned long addr = (unsigned long)ptr;
+	int numpages = len >> PAGE_SHIFT;
+	struct qcom_scm_pas_mt_data chg = {
+		.mt = to_device ? MT_DEVICE_nGnRnE : MT_NORMAL,
+		.to_device = to_device,
+	};
+	int ret;
+
+	if (!numpages || !PAGE_ALIGNED(addr) || !PAGE_ALIGNED(len))
+		return -EINVAL;
+
+	if (to_device) {
+		dcache_clean_inval_poc(addr, addr + len);
+		dsb(ish);
+		isb();
+	}
+
+	ret = set_memory_valid(addr, numpages, 0);
+	if (ret)
+		return ret;
+
+	ret = apply_to_existing_page_range(&init_mm, addr, len,
+					   qcom_scm_pas_set_mt_pte, &chg);
+	if (ret) {
+		set_memory_valid(addr, numpages, 1);
+		return ret;
+	}
+
+	return set_memory_valid(addr, numpages, 1);
+}
+
+/* Device-nGnRnE forbids unaligned and merged accesses. */
+static void qcom_scm_pas_write_ordered(void *dst, const void *src, size_t len)
+{
+	volatile u8 *d = dst;
+	const u8 *s = src;
+	size_t i;
+
+	for (i = 0; i < len; i++)
+		d[i] = s[i];
+	dsb(sy);
+}
+
+static void *qcom_scm_pas_alloc_ordered(size_t size, size_t *alloc_size,
+					dma_addr_t *phys, const char **map_change)
+{
+	struct page *page;
+	unsigned int order;
+	void *ptr;
+	int ret;
+
+	*map_change = "skipped";
+	if (!size || !can_set_direct_map())
+		return NULL;
+
+	/* alloc_pages() rounds up to a power-of-two number of pages. */
+	order = get_order(size);
+	*alloc_size = (size_t)PAGE_SIZE << order;
+	page = alloc_pages(GFP_KERNEL, order);
+	if (!page) {
+		*map_change = "failed";
+		return NULL;
+	}
+
+	ptr = page_address(page);
+	ret = qcom_scm_pas_set_linear_mt(ptr, *alloc_size, true);
+	if (ret) {
+		pr_info("qcom-scm-pas: Device-nGnRnE linear map failed (%d)\n",
+			ret);
+		if (!qcom_scm_pas_set_linear_mt(ptr, *alloc_size, false))
+			__free_pages(page, order);
+		else
+			pr_info("qcom-scm-pas: leaking %zu bytes after failed map\n",
+				*alloc_size);
+		*map_change = "failed";
+		return NULL;
+	}
+
+	*phys = page_to_phys(page);
+	*map_change = "ok";
+	return ptr;
+}
+
+static void qcom_scm_pas_free_ordered(void *ptr, size_t alloc_size)
+{
+	if (qcom_scm_pas_set_linear_mt(ptr, alloc_size, false)) {
+		pr_info("qcom-scm-pas: failed to restore Normal linear map, leaking %zu bytes\n",
+			alloc_size);
+		return;
+	}
+
+	__free_pages(virt_to_page(ptr), get_order(alloc_size));
+}
+#endif /* CONFIG_ARM64 */
+
+static void qcom_scm_pas_free_metadata(bool ordered, size_t size, void *buf,
+				       dma_addr_t phys)
+{
+#ifdef CONFIG_ARM64
+	if (ordered) {
+		qcom_scm_pas_free_ordered(buf, size);
+		return;
+	}
+#else
+	(void)ordered;
+#endif
+	dma_free_coherent(__scm->dev, size, buf, phys);
+}
